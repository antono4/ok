# BytePlus ModelArk API key (get from console.byteplus.com/ark
ARK_API_KEY=your-ark-api-key-here

# Optional: override base URL (default for ap-southeast region
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Optional: override model ID (check Model list page in ModelArk console
SEEDANCE_MODEL=dreamina-seedance-2-5-260628

# --- Stable Video Diffusion (SVD) ---
# NVIDIA NIM API key (remote SVD)
NVIDIA_API_KEY=

# Set 1 untuk memakai SVD lokal (butuh GPU + torch/diffusers)
SVD_LOCAL=0
